{"passage_id": "ME_MANUAL_001", "source_id": "ME_MANUAL", "jurisdiction": "US-ME", "section_path": "Section 11 > Wildlife Safety > May and June are Peak Moose Collision Months!", "printed_page_label": "11-7", "pdf_page_index_1based": null, "page_locator_scope": "wildlife_section_start_only", "text": "Collisions with moose increase dramatically in the months of May and June.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "search_extracted_text", "species": ["moose"], "scenarios": ["seasonal_risk"], "safety_review_required": false, "citation": "web:3", "source_url": "https://www.maine.gov/sos/sites/maine.gov.sos/files/content/assets/motoristhandbook.pdf", "checked_on": "2026-11-20"}
{"passage_id": "ME_MANUAL_002", "source_id": "ME_MANUAL", "jurisdiction": "US-ME", "section_path": "Section 11 > Wildlife Safety > The Moose Standoff", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "exact_page_unverified", "text": "Do not try to drive around a moose", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "search_extracted_text", "species": ["moose"], "scenarios": ["animal_in_road", "standoff"], "safety_review_required": false, "citation": "web:3", "source_url": "https://www.maine.gov/sos/sites/maine.gov.sos/files/content/assets/motoristhandbook.pdf", "checked_on": "2026-11-20"}
{"passage_id": "ME_MANUAL_003", "source_id": "ME_MANUAL", "jurisdiction": "US-ME", "section_path": "Section 11 > Wildlife Safety > What if a Crash is Unavoidable?", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "exact_page_unverified", "text": "If a crash with an animal is imminent, apply the brakes and steer straight.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "search_extracted_text", "species": ["unspecified_wildlife"], "scenarios": ["imminent_collision"], "safety_review_required": true, "citation": "web:3", "source_url": "https://www.maine.gov/sos/sites/maine.gov.sos/files/content/assets/motoristhandbook.pdf", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_001", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > November is Deer Collision Month!", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Collisions with deer increase in the autumn, peaking in November - during breeding season. But they can happen any time of the year.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["deer"], "scenarios": ["seasonal_risk"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_002", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > May and June are Peak Moose Collision Months!", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Collisions with moose increase dramatically in these months. Autumn incidents are also common. But don't let your guard down. Crashes happen 12 months a year.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["seasonal_risk"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_003", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > From Dusk to Dawn", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Although collisions can happen any time of the day, moose and deer are most active around dawn and dusk. They also travel at night.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose", "deer"], "scenarios": ["dawn_dusk", "night_visibility"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_004", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > Warning Signs Mean Business", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "The locations for Maine's moose and deer crossing signs are chosen based on where there are high concentrations of wildlife and where collisions are a problem.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose", "deer"], "scenarios": ["warning_signs"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_005", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > Pay Attention and Keep to the Speed Limit", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Driver distraction and inattention, combined with excess speed, often result in vehicle-wildlife collisions. Always scan the roadside as well as the road. Reducing speed at night greatly improves safety.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["unspecified_wildlife"], "scenarios": ["speed", "roadside_scanning", "night_visibility"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_006", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > Good Visibility is a Must", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "In reduced visibility due to darkness, rain, or fog, travel speed should be adjusted to the conditions. Slowing down when visibility is poor greatly increases your safety.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["unspecified_wildlife"], "scenarios": ["rain_fog", "night_visibility", "speed"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_007", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > Animals Live in the Woods", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Be alert in rural and forested areas. Deer are commonly seen near fields and orchards. Moose are often found near wetlands. Use high beams whenever possible. Watch for the reflective eyes of deer and the silhouette of a moose.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["deer", "moose"], "scenarios": ["habitat", "headlights", "night_visibility"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_008", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > \"Herd\" the One About the Traveling Moose?", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Moose and deer often travel in small groups. If one animal crosses the road, you can bet that there are more animals nearby that may be crossing.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose", "deer"], "scenarios": ["multiple_animals"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_009", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > How Far Ahead Can You See?", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Do not drive beyond your headlights. If you can't stop within the distance of your headlight visibility, you could hit something just beyond your viewing area.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["unspecified_wildlife"], "scenarios": ["headlights", "stopping_distance"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_010", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > The Moose Standoff", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Slow down. Do not try to drive around the moose.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["animal_in_road", "standoff"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_011", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > The Moose Standoff", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Stay in your vehicle. Do not get out to observe or to chase it off the road. By getting out of the car, you put yourself and other drivers at risk. Moose can be unpredictable and may attack your vehicle.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["standoff", "stay_in_vehicle"], "safety_review_required": false, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "ME_DOT_012", "source_id": "ME_DOT", "jurisdiction": "US-ME", "section_path": "Wildlife Safety > What if a Crash is Unavoidable?", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "If a crash with an animal is imminent, apply the brakes and steer straight. Let up on the brakes just before impact to allow the front of your vehicle to rise slightly and aim to hit the tail end of the animal. This can reduce the risk of the animal striking the windshield area and may increase your chances of missing it. Duck down to protect yourself from windshield debris.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["unspecified_wildlife"], "scenarios": ["imminent_collision"], "safety_review_required": true, "citation": "web:5", "source_url": "https://www.maine.gov/dot/publications/crash-and-safety-data/wildlife-safety", "checked_on": "2026-11-20"}
{"passage_id": "NH_GUIDE_001", "source_id": "NH_GUIDE", "jurisdiction": "US-NH", "section_path": "Help Prevent Moose Related Accidents In New Hampshire", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Don't count on seeing \"eye shine.\" Moose eyes do reflect light, but your headlights won't reach that high.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["night_visibility", "headlights"], "safety_review_required": false, "citation": "web:18", "source_url": "https://www.wildlife.nh.gov/wildlife-and-habitat/moose-new-hampshire/brake-moose", "checked_on": "2026-11-20"}
{"passage_id": "NH_GUIDE_002", "source_id": "NH_GUIDE", "jurisdiction": "US-NH", "section_path": "Help Prevent Moose Related Accidents In New Hampshire", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Moose are attracted to salt licks caused by winter road management, so it is not surprising to see them on or very near the road.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["road_salt", "roadside_attraction"], "safety_review_required": false, "citation": "web:18", "source_url": "https://www.wildlife.nh.gov/wildlife-and-habitat/moose-new-hampshire/brake-moose", "checked_on": "2026-11-20"}
{"passage_id": "NH_GUIDE_003", "source_id": "NH_GUIDE", "jurisdiction": "US-NH", "section_path": "Tips for safe driving in moose country", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Don't count on moose stopping when they see you. They are very unpredictable. Stop the car if necessary and wait.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["animal_in_road", "standoff"], "safety_review_required": false, "citation": "web:18", "source_url": "https://www.wildlife.nh.gov/wildlife-and-habitat/moose-new-hampshire/brake-moose", "checked_on": "2026-11-20"}
{"passage_id": "VT_ROADS_001", "source_id": "VT_ROADS", "jurisdiction": "US-VT;Northeast US;Southeast Canada", "section_path": "Staying safe while collecting roadkill data", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Do not touch injured or dead animals.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["unspecified_wildlife"], "scenarios": ["roadkill_reporting", "injured_animal"], "safety_review_required": false, "citation": "web:16", "source_url": "https://anr.vermont.gov/vt-roads-and-wildlife", "checked_on": "2026-11-20"}
{"passage_id": "VT_ROADS_002", "source_id": "VT_ROADS", "jurisdiction": "US-VT;Northeast US;Southeast Canada", "section_path": "Frequently asked questions > What if I can’t identify the animal?", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "At the bottom of the list of species, there are options for “Other mammal,” “Other reptile or amphibian,” and “Bird, other.”", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["other_mammal", "reptile_amphibian", "bird"], "scenarios": ["species_identification"], "safety_review_required": false, "citation": "web:16", "source_url": "https://anr.vermont.gov/vt-roads-and-wildlife", "checked_on": "2026-11-20"}
{"passage_id": "NB_GUIDE_001", "source_id": "NB_GUIDE", "jurisdiction": "CA-NB", "section_path": "Precautions > Scan the sides", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Even while driving within a section of roadway contained by wildlife fencing, drivers should be scanning both sides of the roadway. Although fencing reduces the risk of moose-vehicle collisions, there is still potential for moose to enter the fenced corridor.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["wildlife_fencing", "roadside_scanning"], "safety_review_required": false, "citation": "web:2", "source_url": "https://www.gnb.ca/en/topic/driving-transportation/driving-safety/highway-wildlife.html", "checked_on": "2026-11-20"}
{"passage_id": "NB_GUIDE_002", "source_id": "NB_GUIDE", "jurisdiction": "CA-NB", "section_path": "Precautions > Stay alert", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "If wildlife appears on the roadway, brake firmly and try to avoid swerving. If a large animal such as a moose is directly in the path of the vehicle, consider swerving in a safe direction only if stopping the vehicle is not possible.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose", "unspecified_wildlife"], "scenarios": ["imminent_collision"], "safety_review_required": true, "citation": "web:2", "source_url": "https://www.gnb.ca/en/topic/driving-transportation/driving-safety/highway-wildlife.html", "checked_on": "2026-11-20"}
{"passage_id": "NB_GUIDE_003", "source_id": "NB_GUIDE", "jurisdiction": "CA-NB", "section_path": "Precautions > Stay cautious", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Collisions with moose and deer should be reported to the RCMP. Annual summaries of collision reports are useful in determining which areas require mitigation.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose", "deer"], "scenarios": ["collision_reporting"], "safety_review_required": false, "citation": "web:2", "source_url": "https://www.gnb.ca/en/topic/driving-transportation/driving-safety/highway-wildlife.html", "checked_on": "2026-11-20"}
{"passage_id": "NB_GUIDE_004", "source_id": "NB_GUIDE", "jurisdiction": "CA-NB", "section_path": "Precautions > Stay cautious", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Moose are unpredictable. Leave plenty of space when driving around a moose. If it is frightened, it may run in any direction. Do not exit the vehicle.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["moose"], "scenarios": ["standoff", "stay_in_vehicle"], "safety_review_required": true, "citation": "web:2", "source_url": "https://www.gnb.ca/en/topic/driving-transportation/driving-safety/highway-wildlife.html", "checked_on": "2026-11-20"}
{"passage_id": "RI_GUIDE_001", "source_id": "RI_GUIDE", "jurisdiction": "US-RI", "section_path": "Tips to avoid deer vehicle collisions", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "If a collision is unavoidable, apply the brakes firmly and remain in your lane", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["deer"], "scenarios": ["imminent_collision"], "safety_review_required": true, "citation": "web:88", "source_url": "https://dem.ri.gov/press-releases/love-air-deer-are-move", "checked_on": "2026-11-20"}
{"passage_id": "RI_GUIDE_002", "source_id": "RI_GUIDE", "jurisdiction": "US-RI", "section_path": "Tips to avoid deer vehicle collisions", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "If you see a deer while driving, proceed with caution and expect more than just one deer", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "page_text", "species": ["deer"], "scenarios": ["multiple_animals"], "safety_review_required": false, "citation": "web:88", "source_url": "https://dem.ri.gov/press-releases/love-air-deer-are-move", "checked_on": "2026-11-20"}
{"passage_id": "MA_GUIDE_001", "source_id": "MA_GUIDE", "jurisdiction": "US-MA", "section_path": "Drivers, brake for moose and deer", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Do not swerve to avoid hitting a deer because it may lead to more risk and damage than hitting the deer.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "search_extracted_text", "species": ["deer"], "scenarios": ["imminent_collision"], "safety_review_required": true, "citation": "web:46", "source_url": "https://www.mass.gov/news/drivers-brake-for-moose-and-deer", "checked_on": "2026-11-20"}
{"passage_id": "CT_GUIDE_001", "source_id": "CT_GUIDE", "jurisdiction": "US-CT", "section_path": "DEEP Advises Motorists to Watch for Deer and Moose Along Roadways", "printed_page_label": null, "pdf_page_index_1based": null, "page_locator_scope": "section", "text": "Because moose are taller than deer, drivers may not see their eyes reflect in headlights, making moose harder to spot on the road at night.", "text_type": "source_excerpt_whitespace_normalized", "extraction_basis": "search_extracted_text", "species": ["moose"], "scenarios": ["night_visibility", "headlights"], "safety_review_required": false, "citation": "web:65", "source_url": "https://portal.ct.gov/deep/news-releases/news-releases---2025/deep-advises-motorists-to-watch-for-deer-and-moose-along-roadways", "checked_on": "2026-11-20"}
