{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wildguard.invalid/audio/v1/provenance.schema.json",
  "title": "WildGuard provenance v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "provenance_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_recording_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_release": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "original_metadata": {
      "type": "object"
    },
    "code_commit": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "provenance_id",
    "source_id",
    "source_recording_id",
    "source_release",
    "source_url",
    "retrieved_at",
    "metadata_sha256",
    "original_metadata",
    "code_commit"
  ]
}
